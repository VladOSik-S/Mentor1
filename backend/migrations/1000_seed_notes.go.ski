package migrations

import (
	"database/sql"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"unicode/utf8"

	"github.com/lib/pq"
	"github.com/pressly/goose/v3"
	"gopkg.in/yaml.v3"
)

func init() {
	goose.AddMigration(Up, Down)
}

// NoteFrontmatter represents the YAML frontmatter in markdown files
type NoteFrontmatter struct {
	Title    string   `yaml:"title"`
	Tags     []string `yaml:"tags"`
	IsPublic bool     `yaml:"is_public"`
	Preview  string   `yaml:"preview"`
}

// sanitizeUTF8 removes invalid UTF-8 sequences from a string
func sanitizeUTF8(s string) string {
	if utf8.ValidString(s) {
		return s
	}
	// Convert to valid UTF-8, replacing invalid sequences
	v := make([]rune, 0, len(s))
	for i, r := range s {
		if r == utf8.RuneError {
			_, size := utf8.DecodeRuneInString(s[i:])
			if size == 1 {
				continue // Skip invalid byte
			}
		}
		v = append(v, r)
	}
	return string(v)
}

// ParseMarkdownWithFrontmatter parses a markdown file with YAML frontmatter
func ParseMarkdownWithFrontmatter(content []byte) (*NoteFrontmatter, string, error) {
	// Sanitize the content first
	text := sanitizeUTF8(string(content))

	// Check if file starts with frontmatter delimiter
	if !strings.HasPrefix(text, "---\n") {
		// No frontmatter, return default values
		return &NoteFrontmatter{
			Tags:     []string{},
			IsPublic: false,
		}, text, nil
	}

	// Find the closing delimiter
	parts := strings.SplitN(text[4:], "\n---\n", 2)
	if len(parts) != 2 {
		// Malformed frontmatter, treat as plain content
		return &NoteFrontmatter{
			Tags:     []string{},
			IsPublic: false,
		}, text, nil
	}

	// Parse YAML frontmatter
	var fm NoteFrontmatter
	if err := yaml.Unmarshal([]byte(parts[0]), &fm); err != nil {
		return nil, "", err
	}

	// Sanitize frontmatter strings
	fm.Title = sanitizeUTF8(fm.Title)
	fm.Preview = sanitizeUTF8(fm.Preview)
	for i := range fm.Tags {
		fm.Tags[i] = sanitizeUTF8(fm.Tags[i])
	}

	// Return frontmatter and content (without frontmatter)
	content_text := strings.TrimSpace(parts[1])
	return &fm, content_text, nil
}

func Up(tx *sql.Tx) error {
	// Set client encoding to UTF-8
	_, err := tx.Exec("SET CLIENT_ENCODING TO 'UTF8'")
	if err != nil {
		return fmt.Errorf("failed to set client encoding: %w", err)
	}

	seedDir := "migrations/seed_data"
	files, err := os.ReadDir(seedDir)
	if err != nil {
		return fmt.Errorf("failed to read seed directory: %w", err)
	}

	for _, file := range files {
		if !strings.HasSuffix(file.Name(), ".md") {
			continue
		}

		filePath := filepath.Join(seedDir, file.Name())
		fileContent, err := os.ReadFile(filePath)
		if err != nil {
			return fmt.Errorf("failed to read file %s: %w", file.Name(), err)
		}

		// Force sanitize content regardless of validation
		sanitizedContent := sanitizeUTF8(string(fileContent))

		// Parse frontmatter and content
		fm, content, err := ParseMarkdownWithFrontmatter([]byte(sanitizedContent))
		if err != nil {
			return fmt.Errorf("failed to parse frontmatter in %s: %w", file.Name(), err)
		}

		// Use title from frontmatter or filename
		title := fm.Title
		if title == "" {
			title = strings.TrimSuffix(file.Name(), ".md")
		}
		title = sanitizeUTF8(title)

		// Generate preview if not provided
		preview := fm.Preview
		if preview == "" && len(content) > 200 {
			preview = content[:200] + "..."
		} else if preview == "" {
			preview = content
		}
		preview = sanitizeUTF8(preview)
		content = sanitizeUTF8(content)

		// Sanitize tags
		sanitizedTags := make([]string, len(fm.Tags))
		for i, tag := range fm.Tags {
			sanitizedTags[i] = sanitizeUTF8(tag)
		}

		// Insert or update note
		_, err = tx.Exec(`
			INSERT INTO notes (title, content, tags, is_public, preview, saved_to_migration)
			VALUES ($1, $2, $3, $4, $5, $6)
			ON CONFLICT (title) DO UPDATE SET 
				content = EXCLUDED.content,
				tags = EXCLUDED.tags,
				is_public = EXCLUDED.is_public,
				preview = EXCLUDED.preview,
				updated_at = CURRENT_TIMESTAMP,
				saved_to_migration = EXCLUDED.saved_to_migration
		`, title, content, pq.Array(sanitizedTags), fm.IsPublic, preview, true)
		if err != nil {
			// Log the problematic content for debugging
			fmt.Printf("Error inserting %s. Title length: %d, Content length: %d\n",
				file.Name(), len(title), len(content))
			return fmt.Errorf("failed to insert/update note %s: %w", file.Name(), err)
		}
	}

	return nil
}

func Down(tx *sql.Tx) error {
	// Delete all seeded notes (you might want to be more specific here)
	_, err := tx.Exec("DELETE FROM notes WHERE created_at >= (SELECT MAX(created_at) FROM notes)")
	return err
}
